# Prettier reads .gitignore as well (build output, node_modules, env files).
pnpm-lock.yaml
# The Supabase CLI's local state (ignored by supabase/.gitignore, which Prettier does not read).
supabase/.temp/
# Generated by drizzle-kit: migrations and their snapshots.
drizzle/
# Written by a script and compared byte for byte with its output (`pnpm i18n:routes`).
*.generated.ts
# Copied from node_modules on install (scripts/kiosk-assets.mjs).
public/kiosk/assets/vendor/
# Git worktrees of this repository (parallel agent sessions), each formatted in its own checkout.
.claude/
# Prose: the documents are written by hand and their tables and line breaks are kept as written.
*.md
