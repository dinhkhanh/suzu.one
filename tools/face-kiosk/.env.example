# Copy to .env on the NAS (same folder as docker-compose.yml) and fill in. .env is never committed.

# From SuZu One → Chấm công → Máy chấm công → this device → "Tự gửi lượt chấm" (issue token).
SUZU_DEVICE_TOKEN=
# Long random strings, at least 12 characters, e.g. `openssl rand -hex 32`.
# KIOSK_KEY pairs the tablet once; ADMIN_PASSWORD opens /admin (any user name).
KIOSK_KEY=
ADMIN_PASSWORD=
