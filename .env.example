# Copy to .env.local and fill in. Never commit real values.

# Variable names are the Vercel–Supabase integration's, so `vercel env pull .env.local` configures a
# laptop exactly like production and nothing here needs renaming.

# Postgres. POSTGRES_URL is the pooled connection the app uses; POSTGRES_URL_NON_POOLING the direct
# one migrations use (drizzle.config.ts). Local default = the Supabase stack started by `pnpm db:up`
# (ports set in supabase/config.toml); it has no pooler, so one URL serves both.
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
POSTGRES_URL_NON_POOLING=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production: https://suzu.one
BETTER_AUTH_URL=http://localhost:3000

# The public domain for client review links (/preview) and the careers pages (/careers), with its own
# company home page at /. With it set, that domain serves nothing else (every other path is a 404) and
# the app's domain redirects /preview and /careers to it, so a link handed to a client or a candidate
# never names the internal app. Production: https://suzu.vn — set it for Production only, or preview
# deployments will send their careers pages to the live site. Locally, http://suzu.localhost:3000
# works with no DNS setup. Empty = one domain serves everything; the company home page is /portfolio.
PUBLIC_SITE_URL=

# Google OAuth client (type: External). Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Workspace domains allowed to sign in (comma-separated).
ALLOWED_WORKSPACE_DOMAINS=suzu.vn,suzu.group,bambooads.net

# Emails that may sign in before any person record exists, and receive the Owner role.
BOOTSTRAP_OWNER_EMAILS=

# Scheduled jobs (/api/cron/*). Vercel Cron sends this as a bearer token; set the same value in the
# Vercel project. Generate with: openssl rand -hex 24. Times in vercel.json are UTC (17:05 = 00:05 in Vietnam).
CRON_SECRET=

# Optional dead-man's switch for the schedules (docs/runbooks/incidents.md): the ping URL base of a
# healthchecks.io project (https://hc-ping.com/<ping key>), with one check per schedule named by its
# slug: midnight, morning, evening. Leave empty locally.
CRON_PING_URL=

# Outgoing email through Resend (https://resend.com). Leave the key empty locally: emails are then
# only written to the email_outbox table. The sender's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=SuZu One <no-reply@suzu.one>

# The Cloudflare account that holds the file bucket (R2) and runs the embeddings (Workers AI).
# Dashboard → any page's URL, or Workers & Pages → Account details.
CLOUDFLARE_ACCOUNT_ID=

# Knowledge-base embeddings for the assistant (Cloudflare Workers AI). An API token made from the
# dashboard's "Workers AI" template, limited to the account above. Empty = a deterministic local fake; nothing
# leaves the machine. Changing the model re-embeds everything (the kb-embeddings job).
CLOUDFLARE_AI_API_TOKEN=
EMBEDDINGS_MODEL=@cf/baai/bge-m3

# The assistant's models (Anthropic, SRS D38). Empty key = the local extractive driver: it answers
# with passages quoted from the knowledge base and generates nothing, so the assistant works offline.
# Three tiers: SIMPLE for look-ups and handbook answers, the plain model for complex turns, COMPLEX
# for the hardest answers only.
ANTHROPIC_API_KEY=
# Only when the key is not scoped to a workspace (the API then asks for one): the workspace's ID.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL_SIMPLE=claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_COMPLEX=claude-opus-5-5
# The kill switch: "off" sends nothing to any model, whatever the key.
AI_AGENT_ENABLED=on
# Who gets the agent: "pilot" = the owners and these work emails (comma-separated); "everyone".
AI_AGENT_AUDIENCE=pilot
AI_AGENT_PILOT_EMAILS=
# What the assistant may cost, in USD (SRS D35): the company per month, one person per day by band.
AI_MONTHLY_BUDGET_USD=150
AI_DAILY_BUDGET_USD_EVERYONE=0.3
AI_DAILY_BUDGET_USD_LEADS=0.75
AI_DAILY_BUDGET_USD_OFFICE=1.5

# Private file storage (Cloudflare R2, README "File storage"). An R2 API token's S3 key pair, scoped
# to the one bucket with Object Read & Write; server-only, never exposed to the browser. Locally, use
# a development bucket of your own (with the CORS rule for http://localhost:3000), never
# production's. R2_ENDPOINT only for another S3-compatible store; empty = the account's R2 endpoint.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
STORAGE_BUCKET=suzu-private

# Field encryption for restricted and compensation data. Format: id:key[,id:key...], active key first.
# Generate a key with: openssl rand -base64 32   e.g. DATA_ENCRYPTION_KEYS=k1:<output>
# Production keys live only in Vercel's environment settings, with an offline copy held by the owner.
# Rotation: docs/KEY_ROTATION.md
DATA_ENCRYPTION_KEYS=
DATA_BLIND_INDEX_KEY=

# Web push notifications (VAPID). Generate both with: pnpm push:keys
# Unset = pushes are only recorded (status "simulated") and browsers are not offered push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@suzu.one

# Error tracking (Sentry SDK, src/lib/observability). The Vercel Sentry integration sets the DSN and
# the build variables below. SENTRY_DSN: server errors, failed jobs and public actions (falls back to
# NEXT_PUBLIC_SENTRY_DSN). NEXT_PUBLIC_SENTRY_DSN: browser errors, inlined at build time. Empty = the
# SDK does nothing and errors are only logged. Read directly, not through env(), so a broken
# configuration can still report errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# The environment events are filed under. Leave empty: a Vercel deployment reports as its VERCEL_ENV
# (production / preview) and every other run — `next dev`, a local `next start` — as "development".
# Set only to file a machine under a name of its own. The second one is the browser's, inlined at
# build time.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Performance tracing, 0–1: the share of requests traced on the server. Empty = off.
SENTRY_TRACES_SAMPLE_RATE=
# Source-map upload at build time (next.config.ts). Without the token nothing is uploaded and the
# build still succeeds; stacks in Sentry are then minified.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# The Content-Security-Policy on every page (src/lib/csp.ts).
#   report-only (default) — sent as Content-Security-Policy-Report-Only: browsers block nothing and
#                           report what they would have, to Sentry when a DSN is set above.
#   enforce               — the same policy, enforced. Switch to it once the reports are quiet.
#   off                   — no policy header at all.
CSP_MODE=report-only

# Step-up re-authentication before salary and payroll screens (FR-PLT-06).
#   google (default) — a second Google sign-in (prompt=login, max_age=0). Needs this redirect URI on
#                      the OAuth client: <BETTER_AUTH_URL>/api/step-up/callback
#   local            — a confirm button. Development only: put it in .env.development.local (which
#                      `next start` never reads); the app refuses to start with it in a production
#                      build or on Vercel.
STEP_UP_DRIVER=google

# Google Chat notifications (FR-PLT-31): the incoming-webhook URL of the space that receives
# approval cards. Unset = every card is recorded as "simulated" and nothing leaves the machine.
GOOGLE_CHAT_WEBHOOK_URL=

# Facebook Messenger notifications (docs/MESSENGER.md). The first four are needed together;
# unset = every message is recorded as "simulated" and nothing leaves the machine.
# After setting them: pnpm messenger:setup (webhook fields, Get Started button, utility template).
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
# Any random string (openssl rand -hex 24); paste the same into the app's webhook settings.
MESSENGER_VERIFY_TOKEN=
# The Page's m.me handle, e.g. suzu.one → https://m.me/suzu.one
MESSENGER_PAGE_USERNAME=
# The approved utility template for messages outside Meta's 24-hour window. The setup script
# creates `suzu_one_notification_v2`; set this once Meta has approved it. (`suzu_one_notification`,
# the first one, was created from localhost and its button opens http://localhost:3000.)
MESSENGER_UTILITY_TEMPLATE=
MESSENGER_TEMPLATE_LANGUAGE=vi

# Telegram notifications (docs/TELEGRAM.md). All three are needed together; unset = every
# message is recorded as "simulated" and nothing leaves the machine.
# After setting them: pnpm telegram:setup (registers the webhook with Telegram).
# The token @BotFather gives for the company's bot.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @, e.g. SuZuOneBot → https://t.me/SuZuOneBot
TELEGRAM_BOT_USERNAME=
# openssl rand -hex 32 — Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=

# Google Calendar for interview scheduling (FR-REC-06). A service account with domain-wide
# delegation, plus the mailbox its events are created as (Google will not mint a Meet link
# otherwise). Unset = the local driver: the interview and its .ics still work, the event is
# recorded as "simulated", and nothing leaves the machine.
# The real driver is written against the documented API and HAS NEVER BEEN RUN.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_IMPERSONATE=

# The shared read cache is Vercel's Data Cache (src/lib/cache): on in a Vercel function, off on a
# developer's machine. `off` turns it off on Vercel too. After a seed or a manual SQL fix on a
# deployed database: `pnpm cache:flush <app URL>` (needs CRON_SECRET).
# DATA_CACHE=off