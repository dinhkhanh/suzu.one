{
  "name": "suzu-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/kiosk-assets.mjs && next dev",
    "build": "node scripts/kiosk-assets.mjs && next build",
    "start": "next start",
    "postinstall": "node scripts/kiosk-assets.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "supabase start -x gotrue,realtime,storage-api,edge-runtime,logflare,vector,mailpit,imgproxy,supavisor",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts && tsx scripts/cache-flush.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts && tsx scripts/cache-flush.ts",
    "db:recompute": "tsx scripts/recompute-timesheets.ts",
    "db:seed:demo:ops": "tsx scripts/seed-demo-ops.ts && tsx scripts/cache-flush.ts",
    "db:seed:demo:payroll": "tsx scripts/seed-demo-payroll-runs.ts && tsx scripts/cache-flush.ts",
    "db:seed:demo:pjm": "tsx --require ./scripts/server-only-shim.cjs scripts/seed-demo-pjm.ts && tsx scripts/cache-flush.ts",
    "db:seed:demo:bonus": "tsx scripts/seed-demo-bonus-run.ts && tsx scripts/cache-flush.ts",
    "kb:manual": "tsx --require ./scripts/server-only-shim.cjs scripts/kb-manual.ts",
    "ai:eval": "tsx scripts/ai-eval.ts",
    "push:keys": "tsx scripts/push-keys.ts",
    "messenger:setup": "tsx scripts/messenger-setup.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "brand:icons": "tsx scripts/brand-icons.ts",
    "i18n:routes": "tsx scripts/i18n-route-namespaces.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:down": "supabase stop",
    "vercel-build": "node scripts/kiosk-assets.mjs && if [ \"$VERCEL_ENV\" = \"production\" ]; then drizzle-kit migrate; fi && next build",
    "cache:flush": "tsx scripts/cache-flush.ts",
    "storage:to-r2": "tsx scripts/storage-to-r2.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@floating-ui/dom": "1.8.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@sentry/nextjs": "^11.4.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bubble-menu": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.11",
    "@vercel/speed-insights": "^2.0.0",
    "@videojs/react": "10.0.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.51.0",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "onnxruntime-web": "1.30.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.10",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "fast-check": "^4.10.2",
    "shadcn": "^4.21.1",
    "sharp": "^0.35.5",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.4.1"
}
