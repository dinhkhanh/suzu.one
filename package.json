{
  "name": "suzu-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "supabase start -x gotrue,realtime,edge-runtime,logflare,vector,mailpit,imgproxy,supavisor",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts && tsx scripts/cache-flush.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts && tsx scripts/cache-flush.ts",
    "db:recompute": "tsx scripts/recompute-timesheets.ts",
    "db:seed:demo:ops": "tsx scripts/seed-demo-ops.ts && tsx scripts/cache-flush.ts",
    "db:seed:demo:payroll": "tsx scripts/seed-demo-payroll-runs.ts && tsx scripts/cache-flush.ts",
    "db:seed:demo:pjm": "tsx --require ./scripts/server-only-shim.cjs scripts/seed-demo-pjm.ts && tsx scripts/cache-flush.ts",
    "db:seed:demo:bonus": "tsx scripts/seed-demo-bonus-run.ts && tsx scripts/cache-flush.ts",
    "ai:eval": "tsx scripts/ai-eval.ts",
    "push:keys": "tsx scripts/push-keys.ts",
    "messenger:setup": "tsx scripts/messenger-setup.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "brand:icons": "tsx scripts/brand-icons.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:down": "supabase stop",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then drizzle-kit migrate; fi && next build",
    "cache:flush": "tsx scripts/cache-flush.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@electric-sql/pglite": "^0.5.8",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.9",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.1",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.1"
}
