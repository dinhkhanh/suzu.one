{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "ignoreCommand": "git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':!docs' ':!*.md' ':!.github'",
  "crons": [
    { "path": "/api/cron/midnight", "schedule": "5 17 * * *" },
    { "path": "/api/cron/morning", "schedule": "0 0 * * *" },
    { "path": "/api/cron/evening", "schedule": "0 11 * * *" }
  ]
}
