{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "crons": [
    { "path": "/api/cron/midnight", "schedule": "5 17 * * *" },
    { "path": "/api/cron/morning", "schedule": "0 0 * * *" },
    { "path": "/api/cron/evening", "schedule": "0 11 * * *" },
    { "path": "/api/cron/attendance-checkin-reminders", "schedule": "*/5 * * * *" }
  ]
}
